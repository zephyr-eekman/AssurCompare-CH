@page "/comparateur"
@using AssurCompare.Core.Analyses
@implements IDisposable
@inject PremiumDataService Data
@inject ClientProfileState State

<PageTitle>Comparateur de primes LAMal · AssurCompare CH</PageTitle>

<div class="page-header">
    <div class="eyebrow">Santé · étape 1</div>
    <h1>Comparateur de primes LAMal @_index?.Year</h1>
    <p>Toutes les caisses-maladie du canton, classées pour votre profil à partir des primes officielles de l'OFSP.</p>
</div>

<ProfileBar Sections="ProfileSections.Lamal" />

<MudPaper Class="panel mb-4 filters" Outlined>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4" md="2">
            <MudSelect T="int" Label="Franchise" @bind-Value="_franchise" @bind-Value:after="Recompute" Variant="Variant.Outlined" Dense>
                @foreach (var f in LamalRules.Franchises(State.AgeGroup))
                {
                    <MudSelectItem Value="f">CHF @f</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="8" md="7">
            <div class="filter-label"><InfoTip Term="modèle alternatif" Text="Modèles d'assurance" /></div>
            <MudChipSet T="TariffType" SelectionMode="SelectionMode.MultiSelection" CheckMark Size="Size.Small"
                        SelectedValues="_types" SelectedValuesChanged="OnTypesChanged" Variant="Variant.Outlined" Color="Color.Primary">
                @foreach (var t in Enum.GetValues<TariffType>())
                {
                    <MudChip Value="t" Text="@t.Label()" />
                }
            </MudChipSet>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudSwitch T="bool" @bind-Value="_onePerInsurer" @bind-Value:after="Recompute" Color="Color.Primary" Label="Meilleure offre par caisse" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="mb-3" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="380px" />
}
else if (_stats is null)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff" Size="Size.Large" />
        <p>Aucune offre ne correspond. Cochez au moins un modèle d'assurance pour voir les caisses disponibles.</p>
    </div>
}
else
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="5">
            <MudPaper Outlined Class="panel h-100">
                @if (_reference is not null)
                {
                    var saving = _ranked[0].AnnualSavingVsReference ?? 0;
                    <HeroNumber Label="Économie de prime possible" Value="Math.Max(0, saving)" Unit="/ an" Tone="@(saving > 0 ? "good" : "")">
                        @if (saving > 0)
                        {
                            <span>en passant de <strong>@_reference.Insurer.Name</strong> à <strong>@_ranked[0].Offer.Insurer.Name</strong> (@_ranked[0].Offer.Tariff.Name).</span>
                        }
                        else
                        {
                            <span>Votre caisse actuelle est déjà parmi les moins chères pour cette franchise.</span>
                        }
                    </HeroNumber>
                }
                else
                {
                    <HeroNumber Label="Écart entre la moins chère et la plus chère" Value="_stats.AnnualSpread" Unit="/ an" Tone="accent">
                        pour la même couverture de base. Indiquez votre caisse actuelle dans le profil pour voir votre propre économie.
                    </HeroNumber>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="stat" Outlined>
                <div class="stat-label">La moins chère</div>
                <div class="stat-value">@Chf.Format(_stats.Cheapest)</div>
                <div class="stat-sub">par mois · @_ranked[0].Offer.Insurer.Name</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudPaper Class="stat" Outlined>
                <div class="stat-label">Médiane</div>
                <div class="stat-value">@Chf.Format(_stats.Median)</div>
                <div class="stat-sub">par mois · @_stats.Count offres</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="stat" Outlined>
                <div class="stat-label">La plus chère</div>
                <div class="stat-value">@Chf.Format(_stats.MostExpensive)</div>
                <div class="stat-sub">par mois</div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudPaper Class="panel" Outlined>
                <h2 class="section-title">Combien coûte chaque offre de plus que la n° 1 ?</h2>
                <div class="bars" role="list">
                    @{
                        var first = _ranked[0].ExpectedTotalCost;
                        var shown = _ranked.Take(15).ToList();
                        var max = shown.Max(r => r.ExpectedTotalCost - first);
                    }
                    @foreach (var r in shown)
                    {
                        var extra = r.ExpectedTotalCost - first;
                        var isRef = _reference is not null && ClientAnalysisBuilder.OfferKey(r.Offer) == ClientAnalysisBuilder.OfferKey(_reference);
                        <div class="bar-row @(isRef ? "highlight" : "")" role="listitem"
                             title="@($"{r.Offer.Insurer.Name} · {r.Offer.Tariff.Name} : {Chf.Format(r.Offer.MonthlyPremium)} par mois")">
                            <span class="bar-name">@r.Rank. @r.Offer.Insurer.Name @(isRef ? "(actuelle)" : "")</span>
                            <span class="bar-track"><span class="bar-fill" style="width:@Width(extra, max)"></span></span>
                            <span class="bar-value">@(extra == 0 ? "la moins chère" : "+ " + Chf.Number(extra, false))</span>
                        </div>
                    }
                </div>
                <div class="caption">Surcoût annuel en CHF par rapport à l'offre n° 1 (franchise @_franchise, @(P.HasAccidentInLamal ? "avec" : "sans") accident).</div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Outlined>
                <MudTable Items="_ranked" Dense Hover Elevation="0" Breakpoint="Breakpoint.Sm" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Caisse</MudTh>
                        <MudTh>Modèle</MudTh>
                        <MudTh Class="num">Prime / mois</MudTh>
                        <MudTh Class="num">Coût total / an</MudTh>
                        @if (_reference is not null)
                        {
                            <MudTh Class="num">Économie / an</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#">@context.Rank</MudTd>
                        <MudTd DataLabel="Caisse">@context.Offer.Insurer.Name</MudTd>
                        <MudTd DataLabel="Modèle">
                            @context.Offer.Tariff.Name
                            <div class="muted" style="font-size:.75rem">@context.Offer.Tariff.Type.Label()</div>
                        </MudTd>
                        <MudTd DataLabel="Prime / mois" Class="num">@Chf.Format(context.Offer.MonthlyPremium)</MudTd>
                        <MudTd DataLabel="Coût total / an" Class="num">@Chf.Format(context.ExpectedTotalCost, false)</MudTd>
                        @if (_reference is not null)
                        {
                            var s = context.AnnualSavingVsReference ?? 0;
                            <MudTd DataLabel="Économie / an" Class="@($"num {(s > 0 ? "good" : s < 0 ? "bad" : "")}")">@Chf.Format(s, false)</MudTd>
                        }
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="Lignes par page" InfoFormat="{first_item}-{last_item} sur {all_items}" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
            <div class="caption">
                <InfoTip Term="coût total" Text="Coût total" /> = 12 primes + franchise et quote-part pour @Chf.Format(P.ExpectedHealthCosts, false) de frais médicaux.
            </div>
        </MudItem>
    </MudGrid>

    <div class="result-footer">
        <SaveAnalysisButton />
        <NextStep Href="franchise" Action="Choisir ma franchise">
            La franchise @_franchise est-elle la bonne pour vous ? Vérifions à partir de combien de frais une autre franchise devient rentable.
        </NextStep>
    </div>
}

@code {
    private PremiumIndex? _index;
    private IReadOnlyList<PremiumOffer> _offers = [];
    private IReadOnlyList<RankedOffer> _ranked = [];
    private PremiumOffer? _reference;
    private PremiumStats? _stats;
    private bool _loading = true;
    private string? _loadedCanton;

    private int _franchise;
    private IReadOnlyCollection<TariffType> _types = Enum.GetValues<TariffType>();
    private bool _onePerInsurer = true;

    private Core.Besoins.ClientProfile P => State.Profile;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnProfileChanged;
        _franchise = P.CurrentFranchise ?? LamalRules.DefaultFranchise(State.AgeGroup);
        if (!P.AcceptsAlternativeModels) _types = [TariffType.Standard];
        _index = await Data.GetIndexAsync();
        await Refresh();
    }

    private void OnProfileChanged() => InvokeAsync(Refresh);

    private async Task Refresh()
    {
        if (_loadedCanton != P.Canton)
        {
            _loading = true;
            StateHasChanged();
            _offers = await Data.GetOffersAsync(P.Canton);
            _loadedCanton = P.Canton;
            _loading = false;
        }
        if (!LamalRules.Franchises(State.AgeGroup).Contains(_franchise))
            _franchise = LamalRules.DefaultFranchise(State.AgeGroup);
        Recompute();
        StateHasChanged();
    }

    private void OnTypesChanged(IReadOnlyCollection<TariffType>? types)
    {
        _types = types ?? [];
        Recompute();
    }

    private void Recompute()
    {
        _reference = ClientAnalysisBuilder.CurrentOffer(P, _offers);
        var query = new ComparisonQuery(P.Region, State.AgeGroup, P.HasAccidentInLamal, _franchise, _types.ToHashSet(), P.ExpectedHealthCosts);
        IReadOnlyList<RankedOffer> ranked = PremiumComparer.Rank(_offers, query, _reference);
        if (_onePerInsurer)
        {
            ranked = ranked
                .GroupBy(r => r.Offer.Insurer.Id)
                .Select(g => g.First())
                .OrderBy(r => r.ExpectedTotalCost)
                .Select((r, i) => r with { Rank = i + 1 })
                .ToList();
        }
        _ranked = ranked;
        _stats = PremiumComparer.Stats(ranked.ToList());
    }

    private static string Width(decimal value, decimal max) =>
        (max == 0 ? 0 : value / max * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    public void Dispose() => State.Changed -= OnProfileChanged;
}
