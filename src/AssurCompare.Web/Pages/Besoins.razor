@page "/besoins"
@using AssurCompare.Core.Besoins
@implements IDisposable
@inject ClientProfileState State
@inject IJSRuntime JS

<PageTitle>Analyse des besoins · AssurCompare CH</PageTitle>

<div class="page-header no-print">
    <div class="eyebrow">Biens et responsabilité · étape 1</div>
    <h1>Analyse des besoins</h1>
    <p>
        L'outil d'un premier entretien conseil : la situation du client et ce qu'il possède déjà donnent
        les couvertures obligatoires, les lacunes prioritaires et les pistes d'économie.
    </p>
</div>

<div class="print-only print-head">
    <h1>Analyse des besoins en assurance</h1>
    <div>Client : <strong>@(string.IsNullOrWhiteSpace(P.Name) ? "non renseigné" : P.Name)</strong> · établie le @DateTime.Today.ToString("dd.MM.yyyy")</div>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="5" Class="no-print">
        <MudPaper Class="panel" Outlined>
            <ProfileEditor Sections="ProfileSections.Situation | ProfileSections.Couvertures" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7" Class="print-full">
        <MudPaper Class="panel" Outlined>
            <div class="score-head">
                <HeroNumber Label="Couverture des besoins essentiels" Value="_report.CoverageScore" Format="@(v => $"{v:0} %")"
                            Tone="@(_report.CoverageScore >= 80 ? "good" : "accent")">
                    @(_essentialGaps == 0
                        ? "Les couvertures obligatoires et prioritaires sont en place."
                        : $"{_essentialGaps} point(s) obligatoire(s) ou prioritaire(s) à traiter.")
                </HeroNumber>
                <MudButton Class="no-print" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print"
                           OnClick="Print">Imprimer</MudButton>
            </div>
            <MudProgressLinear Value="_report.CoverageScore" Color="@(_report.CoverageScore >= 80 ? Color.Success : Color.Secondary)" Rounded Class="mb-4" />

            <h2 class="section-title">À traiter</h2>
            @if (!_report.Gaps.Any())
            {
                <MudAlert Severity="Severity.Success">Aucune lacune détectée avec ces informations.</MudAlert>
            }
            @foreach (var item in _report.Gaps)
            {
                <div class="need">
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Class="@(item.Priority <= Priority.Haute ? "bad" : "muted")" />
                    <div>
                        <div class="need-title">@item.Title <span class="priority p@((int)item.Priority)">@item.Priority.Label()</span></div>
                        <div class="need-reason">@item.Reason</div>
                    </div>
                </div>
            }

            @if (_report.Items.Any(i => i.AlreadyCovered))
            {
                <h2 class="section-title mt-4">Déjà en ordre</h2>
                @foreach (var item in _report.Items.Where(i => i.AlreadyCovered))
                {
                    <div class="need">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Class="good" />
                        <div>
                            <div class="need-title">@item.Title</div>
                            <div class="need-reason">@item.Reason</div>
                        </div>
                    </div>
                }
            }

            <div class="caption">
                Analyse indicative établie à partir des informations fournies. Elle ne constitue pas un conseil juridique :
                les conditions exactes dépendent du canton et des contrats.
            </div>
        </MudPaper>

        <div class="result-footer">
            <SaveAnalysisButton />
            <NextStep Href="offres" Action="Comparer des offres">
                Pour chaque couverture à mettre en place, comparez les offres sur leur coût total et pas seulement sur la prime.
            </NextStep>
        </div>
    </MudItem>
</MudGrid>

@code {
    private NeedsReport _report = default!;
    private int _essentialGaps;

    private ClientProfile P => State.Profile;

    protected override void OnInitialized()
    {
        State.Changed += OnProfileChanged;
        Recompute();
    }

    private void OnProfileChanged() => InvokeAsync(() => { Recompute(); StateHasChanged(); });

    private void Recompute()
    {
        _report = NeedsAnalyzer.Analyze(P);
        _essentialGaps = _report.Gaps.Count(g => g.Priority <= Priority.Haute);
    }

    private async Task Print() => await JS.InvokeVoidAsync("print");

    public void Dispose() => State.Changed -= OnProfileChanged;
}
