@page "/pilier-3a"
@using AssurCompare.Core.Besoins
@using AssurCompare.Core.Parametres
@using AssurCompare.Core.Prevoyance
@implements IDisposable
@inject ClientProfileState State

<PageTitle>Calculateur 3e pilier · AssurCompare CH</PageTitle>

<div class="page-header">
    <div class="eyebrow">Prévoyance · étape 2</div>
    <h1>Calculateur 3e pilier (3a)</h1>
    <p>
        Combien rapporte un 3e pilier par rapport à un compte épargne ? Le calcul tient compte du rendement composé
        et de l'impôt économisé chaque année grâce à la déduction des versements.
    </p>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Class="panel" Outlined>
            <h2 class="section-title">Hypothèses</h2>
            <MudStack Spacing="3">
                <div>
                    <div class="filter-label">Année des versements</div>
                    <MudToggleGroup T="int" @bind-Value="_year" @bind-Value:after="Recompute" Color="Color.Primary" Size="Size.Small" CheckMark Outlined>
                        @foreach (var p in SwissParameters.All)
                        {
                            <MudToggleItem Value="p.Year" Text="@p.Year.ToString()" />
                        }
                    </MudToggleGroup>
                </div>
                <MudSwitch T="bool" @bind-Value="_hasPensionFund" @bind-Value:after="Recompute" Color="Color.Primary"
                           Label="Affilié à une caisse de pension (2e pilier)" />
                <div class="limits">
                    @foreach (var p in SwissParameters.All)
                    {
                        <div class="@(p.Year == _year ? "on" : "")">
                            <span>Maximum @p.Year</span>
                            <strong>@Chf.Format(_hasPensionFund ? p.Pillar3aWithPensionFund : p.Pillar3aWithoutPensionFund, false)</strong>
                            @if (!_hasPensionFund) { <small>20 % du revenu au plus</small> }
                        </div>
                    }
                </div>
                <MudNumericField T="decimal" Label="Versement annuel" @bind-Value="_contribution" @bind-Value:after="Recompute"
                                 Min="0" Max="50000" Step="500" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Adornment="Adornment.Start" AdornmentText="CHF" />
                <MudNumericField T="int" Label="Âge actuel" @bind-Value="P.Age" @bind-Value:after="SaveProfile"
                                 Min="18" Max="64" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 HelperText="@($"Simulation jusqu'à 65 ans : {Years} ans")" />
                <MudNumericField T="decimal" Label="Rendement annuel attendu" @bind-Value="_return" @bind-Value:after="Recompute"
                                 Min="-5" Max="10" Step="0.5m" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Adornment="Adornment.End" AdornmentText="%" HelperText="Compte 3a ou solution en fonds" />
                <MudNumericField T="decimal" @bind-Value="P.MarginalTaxRatePct" @bind-Value:after="SaveProfile"
                                 Min="0" Max="50" Step="1" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Adornment="Adornment.End" AdornmentText="%" Label="Taux d'imposition marginal"
                                 HelperText="Dépend du revenu, du canton et de la commune" />
                <MudNumericField T="decimal" Label="Taux du compte épargne (comparaison)" @bind-Value="_savingsRate" @bind-Value:after="Recompute"
                                 Min="0" Max="5" Step="0.25m" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Adornment="Adornment.End" AdornmentText="%" />
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        @if (_result is not null)
        {
            var final = _result.Final;
            @if (_result.ExceedsLegalMaximum)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    Le versement dépasse le maximum légal @_year (@Chf.Format(Pillar3aCalculator.LegalMaximum(_hasPensionFund, _year), false)).
                    Le surplus ne serait pas déductible.
                </MudAlert>
            }
            <MudPaper Outlined Class="panel mb-3">
                <HeroNumber Label="Capital à 65 ans" Value="final.Capital3a" Tone="accent">
                    en versant @Chf.Format(_contribution, false) par an pendant @Years ans, plus
                    <strong class="good">@Chf.Format(final.TaxSavings, false) d'impôts économisés</strong>
                    (<InfoTip Term="taux marginal" Text="@($"taux marginal {P.MarginalTaxRatePct} %")" />).
                </HeroNumber>
            </MudPaper>
            <MudGrid Spacing="3" Class="mb-3">
                <MudItem xs="6" md="4">
                    <MudPaper Class="stat" Outlined>
                        <div class="stat-label">Total versé</div>
                        <div class="stat-value">@Chf.Format(final.TotalContributions, false)</div>
                        <div class="stat-sub">dont @Chf.Format(_result.InvestmentGain, false) de rendement en plus</div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="4">
                    <MudPaper Class="stat" Outlined>
                        <div class="stat-label">Impôts économisés par an</div>
                        <div class="stat-value good">@Chf.Format(_contribution * P.MarginalTaxRatePct / 100, false)</div>
                        <div class="stat-sub">@Chf.Format(final.TaxSavings, false) au total</div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="stat" Outlined>
                        <div class="stat-label">Avantage vs compte épargne</div>
                        <div class="stat-value @(_result.AdvantageVsSavingsAccount > 0 ? "good" : "bad")">@Chf.Format(_result.AdvantageVsSavingsAccount, false)</div>
                        <div class="stat-sub">capital + impôts économisés</div>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Class="panel" Outlined>
                <h2 class="section-title">Évolution du capital</h2>
                <LineChart Series="_series" XTitle="Âge :" StartYAtZero
                           XFormat="@(v => $"{v:0} ans")" YFormat="@(v => Chf.Number(v, false))"
                           AriaLabel="Évolution du capital 3e pilier comparée à un compte épargne"
                           Caption="Versement en fin d'année, rendement constant. L'impôt réduit au moment du retrait n'est pas pris en compte." />
            </MudPaper>

            <div class="result-footer">
                <SaveAnalysisButton />
                <NextStep Href="besoins" Action="Analyser les besoins">
                    La retraite est planifiée. Vérifions maintenant que le logement, la responsabilité civile et la famille sont bien protégés.
                </NextStep>
            </div>
        }
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "versement")] public decimal? RequestedContribution { get; set; }

    private int _year = SwissParameters.Current.Year;
    private bool _hasPensionFund = true;
    private decimal _contribution;
    private decimal _return = 3m;
    private decimal _savingsRate = 0.5m;

    private Pillar3aResult? _result;
    private IReadOnlyList<LineChart.Line> _series = [];

    private ClientProfile P => State.Profile;
    private int Years => Math.Max(1, SwissParameters.RetirementAge - P.Age);

    protected override void OnInitialized()
    {
        State.Changed += OnProfileChanged;
        _hasPensionFund = P.Work != WorkStatus.Independant && P.HasPensionFund;
        _contribution = RequestedContribution is > 0 ? RequestedContribution.Value : Pillar3aCalculator.LegalMaximum(_hasPensionFund, _year);
        Recompute();
    }

    private void OnProfileChanged() => InvokeAsync(() => { Recompute(); StateHasChanged(); });

    private Task SaveProfile() => State.NotifyChangedAsync();

    private void Recompute()
    {
        _result = Pillar3aCalculator.Simulate(
            new Pillar3aInput(_contribution, Years, _return, P.MarginalTaxRatePct, _savingsRate, _hasPensionFund, _year));

        (decimal, decimal) Point(int year, decimal value) => (P.Age + year, value);
        var start = new[] { Point(0, 0) };
        _series =
        [
            new("3e pilier + impôts économisés", "var(--series-1)",
                start.Concat(_result.Years.Select(y => Point(y.Year, y.Capital3a + y.TaxSavings))).ToList(), Emphasis: true),
            new("3e pilier", "var(--series-3)",
                start.Concat(_result.Years.Select(y => Point(y.Year, y.Capital3a))).ToList()),
            new("Compte épargne", "var(--series-2)",
                start.Concat(_result.Years.Select(y => Point(y.Year, y.CapitalSavingsAccount))).ToList()),
        ];
    }

    public void Dispose() => State.Changed -= OnProfileChanged;
}
