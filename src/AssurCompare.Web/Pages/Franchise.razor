@page "/franchise"
@using AssurCompare.Core.Analyses
@implements IDisposable
@inject PremiumDataService Data
@inject ClientProfileState State

<PageTitle>Simulateur de franchise · AssurCompare CH</PageTitle>

<div class="page-header">
    <div class="eyebrow">Santé · étape 2</div>
    <h1>Simulateur de franchise</h1>
    <p>
        Une <InfoTip Term="franchise" /> haute fait baisser la prime, mais on paie plus de sa poche en cas de frais.
        Voici le <InfoTip Term="coût total" /> de chaque franchise et le <InfoTip Term="seuil de rentabilité" />.
    </p>
</div>

<ProfileBar Sections="ProfileSections.Lamal" />

<MudPaper Class="panel mb-4 filters" Outlined>
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Caisse et modèle" @bind-Value="_tariffKey" @bind-Value:after="Recompute" Variant="Variant.Outlined" Dense
                       HelperText="Par défaut : votre caisse actuelle, sinon le modèle standard le moins cher">
                @foreach (var t in _tariffChoices)
                {
                    <MudSelectItem Value="t.Key">@t.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <div class="filter-label">Frais médicaux estimés sur une année : <strong>@Chf.Format(P.ExpectedHealthCosts, false)</strong></div>
            <MudSlider T="decimal" Value="P.ExpectedHealthCosts" ValueChanged="OnCostsChanged" Min="0" Max="@MaxCosts" Step="100" Color="Color.Primary"
                       aria-label="Frais médicaux estimés" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_options.Count > 0)
{
    var best = FranchiseAnalyzer.Best(_options, P.ExpectedHealthCosts, State.AgeGroup);
    var lowest = _options[0];
    var highest = _options[^1];
    var bestCost = FranchiseAnalyzer.AnnualTotalCost(best, P.ExpectedHealthCosts, State.AgeGroup);
    var lowestCost = FranchiseAnalyzer.AnnualTotalCost(lowest, P.ExpectedHealthCosts, State.AgeGroup);
    var breakEven = FranchiseAnalyzer.BreakEven(lowest, highest, State.AgeGroup);

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="5">
            <MudPaper Outlined Class="panel h-100">
                <HeroNumber Label="@($"Avec la franchise {best.Franchise}, vous économisez")" Value="lowestCost - bestCost" Unit="/ an"
                            Tone="@(lowestCost - bestCost > 0 ? "good" : "")">
                    par rapport à la franchise @lowest.Franchise, pour @Chf.Format(P.ExpectedHealthCosts, false) de frais par an.
                    Coût total : @Chf.Format(bestCost, false).
                </HeroNumber>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="stat" Outlined>
                <div class="stat-label">Franchise la plus avantageuse</div>
                <div class="stat-value">CHF @Chf.Number(best.Franchise, false)</div>
                <div class="stat-sub">pour vos frais estimés</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="stat" Outlined>
                <div class="stat-label"><InfoTip Term="seuil de rentabilité" Text="@($"Seuil de rentabilité {lowest.Franchise} / {highest.Franchise}")" /></div>
                @if (breakEven.HealthCosts is decimal threshold)
                {
                    <div class="stat-value">@Chf.Format(threshold, false)</div>
                    <div class="stat-sub">de frais par an : au-delà, la franchise @lowest.Franchise est plus rentable</div>
                }
                else
                {
                    <div class="stat-value">Aucun</div>
                    <div class="stat-sub">la franchise @highest.Franchise reste toujours la moins chère</div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="panel mb-4" Outlined>
        <h2 class="section-title">Coût annuel total selon les frais médicaux</h2>
        <LineChart Series="Series(best.Franchise)" Markers="Markers(breakEven)" XTitle="Frais médicaux :"
                   XFormat="@(v => Chf.Number(v, false))" YFormat="@(v => Chf.Number(v, false))"
                   AriaLabel="Coût annuel total de chaque franchise selon les frais médicaux"
                   Caption="@($"En gras : la franchise {best.Franchise}, la plus avantageuse pour vos frais. Survolez le graphique pour voir les montants exacts.")" />
    </MudPaper>

    <MudPaper Outlined Class="table-scroll">
        <MudSimpleTable Dense Hover Elevation="0">
            <thead>
                <tr>
                    <th>Franchise</th>
                    <th class="num">Prime / mois</th>
                    <th class="num">Primes / an</th>
                    <th class="num">Coût total pour vos frais</th>
                    <th class="num">Coût maximal / an</th>
                    <th>Rentable dès (vs la suivante)</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _options.Count; i++)
                {
                    var o = _options[i];
                    var isBest = o.Franchise == best.Franchise;
                    var worst = o.AnnualPremium + o.Franchise + LamalRules.MaxQuotePart(State.AgeGroup);
                    <tr class="@(isBest ? "row-best" : "")">
                        <td>
                            <span class="viz-swatch" style="background:@SeriesColor(i);margin-right:8px"></span>CHF @o.Franchise
                            @if (isBest)
                            {
                                <span class="tag-good">meilleur choix</span>
                            }
                        </td>
                        <td class="num">@Chf.Format(o.MonthlyPremium)</td>
                        <td class="num">@Chf.Format(o.AnnualPremium, false)</td>
                        <td class="num">@Chf.Format(FranchiseAnalyzer.AnnualTotalCost(o, P.ExpectedHealthCosts, State.AgeGroup), false)</td>
                        <td class="num">@Chf.Format(worst, false)</td>
                        <td>
                            @if (i < _options.Count - 1)
                            {
                                var pair = FranchiseAnalyzer.BreakEven(o, _options[i + 1], State.AgeGroup);
                                @(pair.HealthCosts is decimal t
                                    ? $"dès {Chf.Format(t, false)} de frais (vs {_options[i + 1].Franchise})"
                                    : $"jamais (vs {_options[i + 1].Franchise})")
                            }
                            else
                            {
                                <span class="muted">dernière</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <div class="result-footer">
        <SaveAnalysisButton />
        <NextStep Href="prevoyance" Action="Vérifier ma prévoyance">
            @if (lowestCost - bestCost > 0)
            {
                <span>Vous économisez @Chf.Format(lowestCost - bestCost, false) avec la franchise @best.Franchise. Vérifions maintenant votre prévoyance retraite.</span>
            }
            else
            {
                <span>Votre franchise est réglée. Vérifions maintenant votre prévoyance retraite.</span>
            }
        </NextStep>
    </div>
}
else if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" />
}
else
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" />
        <p>Aucun tarif complet trouvé pour ce profil. Vérifiez le canton et l'âge dans le profil.</p>
    </div>
}

@code {
    private sealed record TariffChoice(string Key, string Label);

    private IReadOnlyList<PremiumOffer> _offers = [];
    private List<TariffChoice> _tariffChoices = [];
    private List<FranchiseOption> _options = [];
    private bool _loading = true;
    private string? _loadedCanton;
    private string? _tariffKey;

    private Core.Besoins.ClientProfile P => State.Profile;
    private decimal MaxCosts => State.AgeGroup == AgeGroup.Enfant ? 5_000m : 10_000m;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnProfileChanged;
        await Refresh();
    }

    private void OnProfileChanged() => InvokeAsync(Refresh);

    private async Task Refresh()
    {
        if (_loadedCanton != P.Canton)
        {
            _loading = true;
            _offers = await Data.GetOffersAsync(P.Canton);
            _loadedCanton = P.Canton;
            _loading = false;
        }
        RefreshTariffs();
        StateHasChanged();
    }

    private IEnumerable<PremiumOffer> Matching =>
        _offers.Where(o => o.Region == P.Region && o.Age == State.AgeGroup && o.WithAccident == P.HasAccidentInLamal);

    private void RefreshTariffs()
    {
        var franchiseCount = LamalRules.Franchises(State.AgeGroup).Count;
        _tariffChoices = Matching
            .GroupBy(ClientAnalysisBuilder.OfferKey)
            .Where(g => g.Count() == franchiseCount)
            .Select(g => g.First())
            .OrderBy(o => o.Insurer.Name).ThenBy(o => o.Tariff.Name)
            .Select(o => new TariffChoice(ClientAnalysisBuilder.OfferKey(o), $"{o.Insurer.Name} · {o.Tariff.Name} ({o.Tariff.Type.Label()})"))
            .ToList();

        if (_tariffChoices.All(t => t.Key != _tariffKey))
        {
            _tariffKey = _tariffChoices.Any(t => t.Key == P.CurrentTariffKey)
                ? P.CurrentTariffKey
                : Matching
                    .Where(o => o.Tariff.Type == TariffType.Standard && o.Franchise == LamalRules.DefaultFranchise(State.AgeGroup))
                    .OrderBy(o => o.MonthlyPremium)
                    .Select(ClientAnalysisBuilder.OfferKey)
                    .FirstOrDefault() ?? _tariffChoices.FirstOrDefault()?.Key;
        }
        Recompute();
    }

    private void Recompute()
    {
        _options = Matching
            .Where(o => ClientAnalysisBuilder.OfferKey(o) == _tariffKey)
            .OrderBy(o => o.Franchise)
            .Select(o => new FranchiseOption(o.Franchise, o.MonthlyPremium))
            .ToList();
    }

    private async Task OnCostsChanged(decimal costs)
    {
        P.ExpectedHealthCosts = costs;
        await State.NotifyChangedAsync();
    }

    private IReadOnlyList<LineChart.Line> Series(int bestFranchise) => _options
        .Select((o, i) => new LineChart.Line(
            $"Franchise {o.Franchise}",
            SeriesColor(i),
            // Pas de 100.- : les cassures (franchise, plafond de quote-part) tombent pile sur un point.
            FranchiseAnalyzer.Curve(o, State.AgeGroup, MaxCosts, 100).Select(p => (p.HealthCosts, p.TotalCost)).ToList(),
            Emphasis: o.Franchise == bestFranchise))
        .ToList();

    private IReadOnlyList<LineChart.Marker> Markers(BreakEvenPoint breakEven)
    {
        var markers = new List<LineChart.Marker> { new(Math.Min(P.ExpectedHealthCosts, MaxCosts), "Vos frais") };
        if (breakEven.HealthCosts is decimal t && t <= MaxCosts)
            markers.Add(new(t, $"Seuil {breakEven.LowFranchise}/{breakEven.HighFranchise}", Row: 1));
        return markers;
    }

    // Couleur fixe par rang de franchise (300 = 1re couleur, 500 = 2e...).
    private static string SeriesColor(int index) => $"var(--series-{index + 1})";

    public void Dispose() => State.Changed -= OnProfileChanged;
}
